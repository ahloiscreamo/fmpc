#!/usr/bin/env bash

G="\033[1;32m"
Y="\033[1;33m"
R="\033[1;31m"
M="\033[1;35m"
C="\033[1;36m"
W="\033[0;90m"
WH="\033[1;37m"
NC="\033[0m"

# show help if asked
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo -e "${M}fmpc${NC} - Fast MPC Browser (Sixel mode)"
    echo -e "--------------------------------"
    echo -e "${G}ENTER${NC}      : Play song"
    echo -e "${Y}TAB${NC}        : Select multi"
    echo -e "${G}Ctrl-x${NC}     : Play selection"
    echo -e "${C}Ctrl-f${NC}     : Search current"
    echo -e "${M}Ctrl-p${NC}     : Toggle play/pause"
    echo -e "${M}Ctrl-n${NC}     : Next track"
    echo -e "${M}Ctrl-b${NC}     : Prev track"
    echo -e "${Y}Ctrl-u${NC}     : Update database"
    echo -e "${Y}?${NC}          : Show shortcuts modal"
    echo -e "${W}ESC${NC}        : Clear search"
    echo -e "${R}Ctrl-q${NC}     : Quit"
    echo -e "--------------------------------"
    exit 0
fi

# keybindings popup modal
if [[ "$1" == "--help-popup" ]]; then
    HELP_TEXT=$(cat << EOF
${G}  ENTER         ${NC} Play selected track
${Y}  TAB           ${NC} Select / deselect multiple tracks
${G}  Ctrl-x        ${NC} Play all selected tracks
${C}  Ctrl-f        ${NC} Search currently playing track
${M}  Ctrl-p        ${NC} Toggle play / pause
${M}  Ctrl-n        ${NC} Next track
${M}  Ctrl-b        ${NC} Previous track
${Y}  Ctrl-u        ${NC} Update MPD database
${Y}  ?             ${NC} Show this shortcut help modal
${W}  ESC           ${NC} Clear search query
${R}  Ctrl-q        ${NC} Quit fmpc
EOF
)
    echo -e "$HELP_TEXT" | fzf \
        --ansi \
        --no-input \
        --pointer="" \
        --border=rounded \
        --border-label="   fmpc Keybindings " \
        --header="  Press any key to return..." \
        --height="50%" \
        --no-info \
        --bind "enter:abort,esc:abort,space:abort,q:abort,change:abort" >/dev/null
    exit 0
fi

# header info renderer
if [[ "$1" == "--header-info" ]]; then
    [[ -z "$2" ]] && exit 0
    FILE="$2"
    ALBUM_DIR=$(dirname "$FILE")
    TRACK_NAME="${FILE##*/}"
    CURRENT=$(mpc current -f "%file%")

    if [[ "$FILE" == "$CURRENT" ]]; then
        STATUS="${G}[ NOW PLAYING ]${NC}"
    else
        STATUS="${W}[ Selected ]${NC}"
    fi

    echo -e "${M}Album:${NC}  ${WH}${ALBUM_DIR}${NC}\n${C}Track:${NC}  ${WH}${TRACK_NAME}${NC}\n${M}Status:${NC} ${STATUS}\n${W}Press ${Y}? ${NC} ${W}for shortcuts${NC}"
    exit 0
fi

# pull user config if present
CONFIG_FILE="$HOME/.config/fmpc/config"
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

export MUSIC_DIR="${MUSIC_DIR:-/mnt/Kingston/Music}"
FIFO_PIPE="/tmp/fmpc_fifo"
UB_PID_FILE="/tmp/fmpc_ub.pid"
CACHE_DIR="$HOME/.cache/fmpc"
export PREVIEW_POS="${PREVIEW_POS:-bottom}"
PREVIEW_SIZE="${PREVIEW_SIZE:-50%}"

BOTTOM_OFFSET_Y="${BOTTOM_OFFSET_Y:-1}"
BOTTOM_H_ADJUST="${BOTTOM_H_ADJUST:-2}"
BOTTOM_MANUAL_ADJUST="${BOTTOM_MANUAL_ADJUST:-2}"
RIGHT_OFFSET_Y="${RIGHT_OFFSET_Y:-1}"
RIGHT_H_ADJUST="${RIGHT_H_ADJUST:-2}"

# preview pane renderer
if [[ "$1" == "--preview" ]]; then
    [[ -z "$2" ]] && exit

    FILE="$2"
    FULL_PATH="$MUSIC_DIR/$FILE"
    ALBUM_DIR=$(dirname "$FILE")
    ALBUM_HASH=$(echo "$ALBUM_DIR" | md5sum | cut -d' ' -f1)
    ALBUM_COVER="$CACHE_DIR/${ALBUM_HASH}.jpg"

    mkdir -p "$CACHE_DIR"

    # grab cover art if missing
    if [[ ! -f "$ALBUM_COVER" ]]; then
        timeout 2s ffmpeg -i "$FULL_PATH" -an -vframes 1 -q:v 2 "$ALBUM_COVER" -y >/dev/null 2>&1
    fi

    if [[ -f "$ALBUM_COVER" && -p "$FIFO_PIPE" ]]; then
        if [[ "$PREVIEW_POS" == "bottom" ]]; then
            dims=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$ALBUM_COVER")
            IFS=x read -r W_PX H_PX <<< "$dims"
            [[ -z "$W_PX" || -z "$H_PX" ]] && { W_PX=1; H_PX=1; }

            OFFSET_Y=$((FZF_PREVIEW_TOP + BOTTOM_OFFSET_Y))
            IMG_H=$((FZF_PREVIEW_LINES - BOTTOM_H_ADJUST))
            MANUAL_ADJUST=$BOTTOM_MANUAL_ADJUST

            IMG_W=$(( (IMG_H * W_PX * 25) / (H_PX * 10) ))
            [[ $IMG_W -gt $FZF_PREVIEW_COLUMNS ]] && IMG_W=$FZF_PREVIEW_COLUMNS
            IMG_X=$(( FZF_PREVIEW_LEFT + (FZF_PREVIEW_COLUMNS - IMG_W) / 2 + MANUAL_ADJUST ))
        else
            IMG_X=$FZF_PREVIEW_LEFT
            IMG_W=$FZF_PREVIEW_COLUMNS
            IMG_H=$((FZF_PREVIEW_LINES - RIGHT_H_ADJUST))
            OFFSET_Y=$((FZF_PREVIEW_TOP + RIGHT_OFFSET_Y))
        fi

        printf '{"action": "remove", "identifier": "fmpc-preview"}\n' > "$FIFO_PIPE"
        printf '{"action": "add", "identifier": "fmpc-preview", "x": %d, "y": %d, "width": %d, "height": %d, "scaler": "fit_contain", "path": "%s"}\n' \
            "$IMG_X" "$OFFSET_Y" "$IMG_W" "$IMG_H" "$ALBUM_COVER" > "$FIFO_PIPE"
    fi
    exit
fi

# clean up on exit
cleanup() {
    if [ -f "$FOLLOW_PID_FILE" ]; then
        follower_pid=$(cat "$FOLLOW_PID_FILE")
        kill "$follower_pid" 2>/dev/null
    fi
    [ -f "$UB_PID_FILE" ] && kill -9 "$(cat "$UB_PID_FILE")" 2>/dev/null
    tput cnorm; tput rmcup;
    rm -f "$UB_PID_FILE" "$FIFO_PIPE" "$FOLLOW_PID_FILE" "$LIST_CACHE" "$FZF_SOCK_PATH"
    exit
}
trap cleanup EXIT

# start ueberzugpp layer daemon
rm -f "$FIFO_PIPE"
mkfifo "$FIFO_PIPE"
ueberzugpp layer --silent -o "${UB_OUTPUT:-sixel}" < <(tail -f "$FIFO_PIPE") &
echo $! > "$UB_PID_FILE"

LIST_CACHE="/tmp/fmpc_list_cache"
FOLLOW_PID_FILE="/tmp/fmpc_follow.pid"
FZF_SOCK_PATH="/tmp/fmpc.sock"
FOLLOWER_SCRIPT="$HOME/.local/bin/fmpc-follower"

# cache mpd library
mpc listall > "$LIST_CACHE"

# jump to currently playing track
current_file=$(mpc current -f "%file%")
initial_jump_index=1
if [[ -n "$current_file" ]]; then
    index_from_awk=$(awk -v song="$current_file" '$0 == song { print NR; exit }' "$LIST_CACHE")
    [[ -n "$index_from_awk" ]] && initial_jump_index=$index_from_awk
fi

DIR_COL=$'\e[35m'
FILE_COL=$'\e[37m'
RESET=$'\e[0m'

if [[ "$PREVIEW_POS" == "bottom" ]]; then
    LIST_CMD="sed \"s|^.*/\(.*\)$|${FILE_COL}\1${RESET}\t&|\" $LIST_CACHE"
else
    LIST_CMD="sed \"s|^\(.*\)/\(.*\)$|${DIR_COL}\1/${FILE_COL}\2${RESET}\t\1/\2|\" $LIST_CACHE"
fi

# main interface
eval "$LIST_CMD" | fzf \
    --ansi \
    --delimiter '\t' \
    --with-nth=1 \
    --multi \
    --listen="$FZF_SOCK_PATH" \
    --prompt " 󰎆 Music > " \
    --preview "$0 --preview {2}" \
    --preview-window="${PREVIEW_POS}:${PREVIEW_SIZE}:border-rounded" \
    --bind "load:pos($initial_jump_index)+transform-header($0 --header-info {2})" \
    --bind "focus:transform-header($0 --header-info {2})" \
    --bind "start:execute($FOLLOWER_SCRIPT '$LIST_CACHE' '$FZF_SOCK_PATH' & echo \$! > '$FOLLOW_PID_FILE')" \
    --bind "enter:execute-silent($HOME/.local/bin/fmpc-play {2} >/dev/null 2>&1)+transform-header($0 --header-info {2})+refresh-preview" \
    --bind "ctrl-x:execute($HOME/.local/bin/fmpc-play {+2} >/dev/null 2>&1)+deselect-all" \
    --bind "esc:change-query()+top" \
    --bind "change:top" \
    --bind "ctrl-f:transform-query(mpc current -f '%file%' | sed 's|.*/||')" \
    --bind "ctrl-p:execute-silent(mpc toggle >/dev/null 2>&1)+transform-header($0 --header-info {2})+refresh-preview" \
    --bind "ctrl-n:execute-silent(mpc next >/dev/null 2>&1)+transform-header($0 --header-info {2})+refresh-preview" \
    --bind "ctrl-b:execute-silent(mpc prev >/dev/null 2>&1)+transform-header($0 --header-info {2})+refresh-preview" \
    --bind "ctrl-u:execute-silent(mpc update >/dev/null 2>&1)+transform-header($0 --header-info {2})+refresh-preview" \
    --bind "?:execute($0 --help-popup)+refresh-preview" \
    --bind "ctrl-q:abort" \
    --reverse --border
